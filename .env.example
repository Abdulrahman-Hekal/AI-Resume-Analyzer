# ==============================================================================
# AI Resume Analyzer - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="AI Resume Analyzer"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY="super-secret-jwt-signing-key-for-graduation-project-demo-replace-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./data/resume_analyzer.db"

# File Upload Constraints
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB in bytes
ALLOWED_EXTENSIONS=["pdf", "docx"]

# AI Providers & Cascading Strategy
# Options: "cascade" (Recommended: Gemini -> Groq -> Local NLP), "gemini", "groq", "local"
AI_PROVIDER="cascade"

# Free LLM API 1: Google Gemini (Get free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Free LLM API 2: Groq (Get free key: https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# RAG & Embeddings Configuration
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.15

# Matching Weights Formula (Must sum to 1.0)
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.25
WEIGHT_EDUCATION=0.15
WEIGHT_SEMANTIC=0.20

# CORS
CORS_ORIGINS=["*"]
